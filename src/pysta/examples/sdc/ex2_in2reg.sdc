# ==========================================================================
# 例 2：输入端口 -> 寄存器的 D 端口
#
# 时钟周期 20ns。芯片外部已经占掉 7.4ns（包含上游寄存器的 Tco、外部组合逻辑
# 和线网延时），触发器建立时间 1ns，于是内部逻辑只剩下：
#
#     budget = Tclk - input_delay - Tsu - uncertainty
#            = 20 - 7.4 - 1.0 - 0 = 11.6ns
#
# set_input_delay 就是把这些“工具看不到的外部时间”告诉工具的方式。
# ==========================================================================

create_clock -period 20 [get_ports clk]
set_input_delay -max 7.4 -clock clk [get_ports A]
