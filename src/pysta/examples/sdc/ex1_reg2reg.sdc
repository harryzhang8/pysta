# ==========================================================================
# 例 1：寄存器 -> 寄存器
#
# 时钟周期 10ns，只需要一条 create_clock ——
# 寄存器之间的路径“一旦时钟定义好”就自动被约束了，不用额外写约束。
#
# 算出来的 budget = Tclk - Tco - Tsu - uncertainty = 10 - 1.0 - 1.0 = 8.0ns
# ==========================================================================

create_clock -period 10 [get_ports clk]
